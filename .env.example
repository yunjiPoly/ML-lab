# Copy to .env at the repository root.  Every value is optional; defaults work
# for local development without any cloud service.  Never commit .env.

# --- general ---
DEBUG=false
LOG_LEVEL=INFO
LOG_JSON=false

# --- database (SQLite by default; switch to PostgreSQL later) ---
# DATABASE_URL=sqlite:///D:/LABS/yugioh-lab/data/yugioh.sqlite3
# DATABASE_URL=postgresql+psycopg://user:password@localhost:5432/yugioh

# --- API ---
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Regex for extra dev origins (LAN IPs so a phone can reach the dev server). Leave empty to disable.
# CORS_ORIGIN_REGEX=^https?://(localhost|192\.168\.\d+\.\d+)(:\d+)?$
MAX_UPLOAD_BYTES=12582912
ALLOWED_UPLOAD_MIME_TYPES=image/jpeg,image/png,image/webp
# Write debug images for API requests under data/debug (uploads are never stored otherwise).
SAVE_DEBUG_IMAGES=false

# --- card geometry / ROI ---
CARD_WIDTH=421
CARD_HEIGHT=614
CARD_LAYOUT=standard
OCR_SCALE=2
ALLOW_FULL_IMAGE_FALLBACK=true

# --- OCR ---
OCR_PROVIDER=paddle
OCR_DEVICE=cpu
OCR_REC_MODEL=PP-OCRv6_medium_rec
OCR_MIN_CONFIDENCE=0.30

# --- resolver ---
RESOLVER_NAME_CANDIDATE_THRESHOLD=0.70
RESOLVER_NAME_STRONG_THRESHOLD=0.90

# --- visual fallback (disabled; future DINOv2) ---
VISUAL_RECOGNIZER=noop

# --- data provider ---
CARD_DATA_PROVIDER=ygoprodeck
YGOPRODECK_BASE_URL=https://db.ygoprodeck.com/api/v7
YGOPRODECK_REQUEST_DELAY_SECONDS=0.15
