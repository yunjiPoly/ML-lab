# Copy to frontend/.env.local (git-ignored). Every value is optional.

# Base URL of the backend API as seen from the browser, e.g. http://192.168.1.20:8000
# Leave empty (default) to use the same origin: the Vite dev server proxies /api
# to the backend, so no CORS configuration is needed during development.
VITE_API_BASE_URL=

# Where the Vite dev-server proxy forwards /api requests (the FastAPI backend).
VITE_API_PROXY_TARGET=http://localhost:8000

# Serve the dev server over HTTPS with a self-signed certificate so that a phone
# on the LAN can use the camera (getUserMedia requires a secure context on every
# host except localhost). Accept the certificate warning once on the phone.
VITE_HTTPS=false
